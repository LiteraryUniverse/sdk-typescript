{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"declaration": true,
		"skipLibCheck": true,
		"rootDir": "src",
		"outDir": "dist/esm",
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts", "src/**/*.cts"]
}
